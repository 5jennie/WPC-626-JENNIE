$(function() {
    function setCookie(name, value, days) {
        var expires = "";
        if (days) {
            var date = new Date();
            date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
            expires = "; expires=" + date.toUTCString();
        }
        document.cookie = name + "=" + (value || "")  + expires + "; path=/";
    }

    function getCookie(name) {
        var nameEQ = name + "=";
        var ca = document.cookie.split(';');
        for(var i=0;i < ca.length;i++) {
            var c = ca[i];
            while (c.charAt(0)==' ') c = c.substring(1,c.length);
            if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length,c.length);
        }
        return null;
    }
    // story tagline 등장
    var $tagline = $('#intro-text #tagline');
    var originalText = '백년을 잇는 향기'.split('').map(char => char === ' ' ? '&nbsp;' : char);
    $tagline.empty();
    $.each(originalText, function(i, char) {
        $tagline.append($('<span>').html(char));
    });
    function animateTagline() {
        $tagline.find('span').each(function(i) {
            $(this).delay(i * 100).animate({
                opacity: 1,
                top: 0
            }, {
                duration: 700,
                easing: 'easeOutCubic',
                step: function(now, fx) {
                    if (fx.prop === "opacity") {
                        var translateY = (1 - now) * 30; // 30px에서 시작해서 0px로
                        var blurValue = (1 - now) * 10; // 10px에서 시작해서 0px로
                        $(this).css({
                            transform: `translateY(${translateY}px)`,
                            opacity: now,
                            filter: `blur(${blurValue}px)`
                        });
                    }
                }
            });
        });
    }
	animateTagline();

