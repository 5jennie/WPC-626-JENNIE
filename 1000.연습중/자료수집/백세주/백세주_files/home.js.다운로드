    if (!getCookie('intro_shown')) {
        // 인트로 애니메이션 실행
        $('#intro-text').fadeIn(500).delay(2000).fadeOut(1000);
        $('#symbol-mark').delay(2500).fadeIn(700).delay(2000).fadeOut(1000, function() {
            $('#intro-container').fadeOut(500);
        });

        // 나이 확인 팝업 표시
        $('#age-verification-overlay').delay(7000).fadeIn(500);
    } else {
        // 쿠키가 있으면 인트로와 팝업을 건너뜁니다
        $('#intro-container').hide();
        $('#age-verification-overlay').hide();
    }

    // Yes 버튼 클릭 시
    $('#age-yes').click(function() {
        $('#age-verification-overlay').fadeOut(500);
        // 쿠키 설정 (1일 동안 유효)
        setCookie('intro_shown', 'true', 1);
    });

    // No 버튼 클릭 시
    $('#age-no').click(function() {
        alert('죄송합니다. 19세 이상만 입장 가능합니다.');
        // 여기에 리다이렉션 또는 다른 동작을 추가할 수 있습니다.
